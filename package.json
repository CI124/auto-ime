{
  "name": "auto-ime",
  "displayName": "Auto IME",
  "description": "Auto switch input method based on code context using AST (Linux & Windows)",
  "publisher": "CI124",
  "version": "0.8.1-beta",
  "repository": {
    "type": "git",
    "url": "https://github.com/CI124/auto-ime.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Keymaps",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "auto-ime.escape",
        "title": "Vim Escape and Switch to English"
      },
      {
        "command": "auto-ime.toggleIME",
        "title": "Toggle IME (Chinese/English)"
      }
    ],
    "keybindings": [
      {
        "command": "auto-ime.escape",
        "key": "escape",
        "when": "vim.mode == 'Insert' && editorTextFocus"
      },
      {
        "command": "auto-ime.toggleIME",
        "key": "ctrl+shift+space",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Auto IME",
      "properties": {
        "auto-ime.ibus.englishEngine": {
          "type": "string",
          "default": "xkb:us::eng",
          "description": "IBus engine name for English (find using 'ibus engine')"
        },
        "auto-ime.ibus.chineseEngine": {
          "type": "string",
          "default": "libpinyin",
          "description": "IBus engine name for Chinese (find using 'ibus engine')"
        },
        "auto-ime.windows.pollingInterval": {
          "type": "number",
          "default": 150,
          "minimum": 50,
          "maximum": 1000,
          "description": "Windows IME state polling interval in milliseconds (lower = more responsive, higher = less CPU)"
        }
      }
    }
  },
  "scripts": {
    "check-env": "node scripts/check-env.js",
    "postinstall": "node scripts/download-wasm.js",
    "precompile": "node scripts/check-env.js",
    "compile": "node esbuild.js",
    "prewatch": "node scripts/check-env.js",
    "watch": "node esbuild.js --watch"
  },
  "dependencies": {
    "@koromix/koffi-win32-x64": "^3.0.2",
    "koffi": "^3.0.2",
    "web-tree-sitter": "^0.22.6"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.18.0",
    "typescript": "^5.1.3"
  }
}
